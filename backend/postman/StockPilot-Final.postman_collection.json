{
  "info": {
    "name": "StockPilot Final - Local API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Use this collection's Variables tab. Enter email once. Register and log in directly (OTP removed). Requests use collection values automatically."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "01 Account \u2014 send one at a time",
      "item": [
        {
          "name": "01 Register user [200]",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/register",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Inventory Manager\",\n  \"email\": {{emailJson}},\n  \"password\": {{passwordJson}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.variables.set('emailJson', JSON.stringify(String(pm.collectionVariables.get('email') || '')));",
                  "pm.variables.set('passwordJson', JSON.stringify(String(pm.collectionVariables.get('password') || '')));",
                  "for (const key of [\"baseUrl\", \"email\", \"password\", \"otp\", \"token\", \"supplierId\", \"productId\", \"orderId\", \"sku\", \"fromDate\", \"toDate\"]) {",
                  "  const value = pm.collectionVariables.get(key);",
                  "  const numericId = ['supplierId','productId','orderId'].includes(key);",
                  "  pm.variables.set(key, numericId ? (Number(value) || 0) : String(value || ''));",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) pm.test('Response data', () => { const j=pm.response.json(); pm.expect(j.email).to.eql(String(pm.variables.get(\"email\")).trim().toLowerCase()); });"
                ]
              }
            }
          ]
        },
        {
          "name": "02 Verify code from inbox [200]",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/verify-otp",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": {{emailJson}},\n  \"otp\": {{otpJson}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.variables.set('emailJson', JSON.stringify(String(pm.collectionVariables.get('email') || '')));",
                  "pm.variables.set('otpJson', JSON.stringify(String(pm.collectionVariables.get('otp') || '')));",
                  "for (const key of [\"baseUrl\", \"email\", \"password\", \"otp\", \"token\", \"supplierId\", \"productId\", \"orderId\", \"sku\", \"fromDate\", \"toDate\"]) {",
                  "  const value = pm.collectionVariables.get(key);",
                  "  const numericId = ['supplierId','productId','orderId'].includes(key);",
                  "  pm.variables.set(key, numericId ? (Number(value) || 0) : String(value || ''));",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) pm.test('Response data', () => { const j=pm.response.json(); pm.expect(j.message).to.be.a(\"string\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "03 Log in and save token [200]",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": {{emailJson}},\n  \"password\": {{passwordJson}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.unset('token');",
                  "pm.variables.set('emailJson', JSON.stringify(String(pm.collectionVariables.get('email') || '')));",
                  "pm.variables.set('passwordJson', JSON.stringify(String(pm.collectionVariables.get('password') || '')));",
                  "for (const key of [\"baseUrl\", \"email\", \"password\", \"otp\", \"token\", \"supplierId\", \"productId\", \"orderId\", \"sku\", \"fromDate\", \"toDate\"]) {",
                  "  const value = pm.collectionVariables.get(key);",
                  "  const numericId = ['supplierId','productId','orderId'].includes(key);",
                  "  pm.variables.set(key, numericId ? (Number(value) || 0) : String(value || ''));",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) pm.collectionVariables.set('token', pm.response.json().accessToken);",
                  "if (pm.response.code === 200) pm.test('Response data', () => { const j=pm.response.json(); pm.expect(j.tokenType).to.eql(\"Bearer\"); pm.expect(j.accessToken.split(\".\")).to.have.lengthOf(3); });"
                ]
              }
            }
          ]
        }
      ]
    },
