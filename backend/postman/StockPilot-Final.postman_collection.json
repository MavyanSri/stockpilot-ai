          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const t=new Date(); const d=x=>x.getFullYear()+'-'+String(x.getMonth()+1).padStart(2,'0')+'-'+String(x.getDate()).padStart(2,'0'); pm.collectionVariables.set('toDate',d(t)); t.setDate(t.getDate()-6); pm.collectionVariables.set('fromDate',d(t));",
                  "for (const key of [\"baseUrl\", \"email\", \"password\", \"otp\", \"token\", \"supplierId\", \"productId\", \"orderId\", \"sku\", \"fromDate\", \"toDate\"]) {",
