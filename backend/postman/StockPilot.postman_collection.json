                ]
              }
            }
          ]
        },
        {
          "name": "Dashboard",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/dashboard/summary"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Low stock",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/alerts/low-stock"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Sales report",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/reports/sales?from={{fromDate}}&to={{toDate}}"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const t=new Date(); const d=x=>x.getFullYear()+'-'+String(x.getMonth()+1).padStart(2,'0')+'-'+String(x.getDate()).padStart(2,'0'); if (!pm.collectionVariables.get('toDate')) pm.collectionVariables.set('toDate',d(t)); t.setDate(t.getDate()-6); if (!pm.collectionVariables.get('fromDate')) pm.collectionVariables.set('fromDate',d(t));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
