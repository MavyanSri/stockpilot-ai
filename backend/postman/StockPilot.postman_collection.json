          ]
        }
      ]
    },
    {
      "name": "3. Stock, dashboard and sales",
      "item": [
        {
          "name": "Opening stock of 6",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/stock-transactions",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": {{productId}},\n  \"type\": \"IN\",\n  \"reason\": \"OPENING\",\n  \"quantity\": 6\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Sell 2 cables",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/stock-transactions",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": {{productId}},\n  \"type\": \"OUT\",\n  \"reason\": \"SALE\",\n  \"quantity\": 2\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Balance 4 and low stock',()=>{const j=pm.response.json();pm.expect(j.currentStock).to.equal(4);pm.expect(j.lowStock).to.be.true;});"
                ]
              }
            }
          ]
        },
        {
          "name": "Reject overselling",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/stock-transactions",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": {{productId}},\n  \"type\": \"OUT\",\n  \"reason\": \"SALE\",\n  \"quantity\": 5\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected HTTP 409', () => pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        },
        {
          "name": "Stock history",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/stock-transactions?productId={{productId}}"
          },
          "event": [
            {
              "listen": "test",
